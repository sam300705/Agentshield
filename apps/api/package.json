{
  "name": "@agentshield/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "corepack pnpm --filter @agentshield/scanner --filter @agentshield/policy-engine --filter @agentshield/remediation build",
    "dev": "tsx watch --tsconfig=tsconfig.runtime.json src/index.ts",
    "prebuild": "corepack pnpm --filter @agentshield/scanner --filter @agentshield/policy-engine --filter @agentshield/remediation build",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "pretypecheck": "corepack pnpm --filter @agentshield/scanner --filter @agentshield/policy-engine --filter @agentshield/remediation build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentshield/policy-engine": "workspace:*",
    "@agentshield/remediation": "workspace:*",
    "@agentshield/scanner": "workspace:*",
    "@agentshield/schemas": "workspace:*",
    "@prisma/client": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "bullmq": "^6.3.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.0.0",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
