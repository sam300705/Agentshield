generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FindingCategory {
  SECRET
  DOCKERFILE
  KUBERNETES
  DEPENDENCY
  AGENT_WORKFLOW
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ScanStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum PolicyDecisionType {
  ALLOW
  WARN
  REQUIRE_APPROVAL
  BLOCK
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PackageManager {
  NPM
  PNPM
  YARN
  UNKNOWN
}

enum DependencyScope {
  PRODUCTION
  DEVELOPMENT
  OPTIONAL
  PEER
  UNKNOWN
}

enum AuditAction {
  SCAN_CREATED
  SCAN_COMPLETED
  FINDING_CREATED
  POLICY_DECIDED
  REMEDIATION_CREATED
  APPROVAL_REQUESTED
  APPROVAL_UPDATED
  AGENT_EVENT_INGESTED
  POLICY_SIMULATED
  RECEIPT_GENERATED
}

enum OrganizationRole {
  VIEWER
  DEVELOPER
  SECURITY_REVIEWER
  POLICY_ADMINISTRATOR
  ORGANIZATION_ADMINISTRATOR
}

enum AgentSessionStatus {
  ACTIVE
  COMPLETED
  BLOCKED
  FAILED
  CANCELLED
}

enum AgentEventType {
  TOOL_INVOCATION
  SHELL_COMMAND
  FILE_READ
  FILE_MODIFICATION
  DEPENDENCY_INSTALLATION
  NETWORK_REQUEST
  SECRET_ACCESS_ATTEMPT
  INFRASTRUCTURE_CHANGE
  POLICY_EVALUATION
  APPROVAL_REQUEST
  HUMAN_DECISION
}

enum PolicyEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum PolicyBundleStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SimulationStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum RiskNodeKind {
  TASK
  EVENT
  RESOURCE
  RISK
  POLICY
  DECISION
}

enum EdgeConfidence {
  CONFIRMED
  INFERRED
}

model Scan {
  id             String             @id @default(cuid())
  repositoryName String
  repositoryUrl  String?
  branch         String
  commitSha      String?
  status         ScanStatus         @default(QUEUED)
  metadata       Json               @default("{}")
  startedAt      DateTime           @default(now())
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  findings       Finding[]
  dependencies   Dependency[]
  auditEvents    AuditEvent[]
  organizationId String?
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  repositoryId   String?
  repository     Repository?        @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  sessionId      String?
  session        AgentSession?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  job            ScanJob?
  simulations    PolicySimulation[]
  receipt        SecurityReceipt?
  advisories     Advisory[]
  githubDeliveries GitHubWebhookDelivery[]

  @@index([status])
  @@index([repositoryName])
  @@index([organizationId, createdAt])
  @@index([repositoryId, createdAt])
  @@index([sessionId])
}

model Finding {
  id             String          @id @default(cuid())
  scanId         String
  scan           Scan            @relation(fields: [scanId], references: [id], onDelete: Cascade)
  category       FindingCategory
  severity       Severity
  title          String
  description    String
  filePath       String
  lineStart      Int?
  lineEnd        Int?
  evidence       Json            @default("{}")
  fingerprint    String          @unique
  createdAt      DateTime        @default(now())
  policyDecision PolicyDecision?
  remediation    Remediation?
  approval       Approval?

  @@index([scanId])
  @@index([category])
  @@index([severity])
}

model PolicyDecision {
  id           String             @id @default(cuid())
  findingId    String             @unique
  finding      Finding            @relation(fields: [findingId], references: [id], onDelete: Cascade)
  decision     PolicyDecisionType
  ruleId       String
  ruleVersion  String
  reason       String
  ruleSnapshot Json
  decidedAt    DateTime           @default(now())

  @@index([decision])
  @@index([ruleId])
}

model Remediation {
  id                   String             @id @default(cuid())
  findingId            String             @unique
  finding              Finding            @relation(fields: [findingId], references: [id], onDelete: Cascade)
  summary              String
  detail               String?
  steps                Json               @default("[]")
  patch                Json?
  generatedForDecision PolicyDecisionType
  createdAt            DateTime           @default(now())

  @@index([generatedForDecision])
}

model Approval {
  id          String         @id @default(cuid())
  findingId   String         @unique
  finding     Finding        @relation(fields: [findingId], references: [id], onDelete: Cascade)
  status      ApprovalStatus @default(PENDING)
  actor       String
  reason      String?
  requestedAt DateTime       @default(now())
  reviewedAt  DateTime?
  requestedBy String         @default("system")
  reviewedBy  String?
  nonce       String?        @unique

  @@index([status])
  @@index([actor])
}

model Dependency {
  id             String          @id @default(cuid())
  scanId         String
  scan           Scan            @relation(fields: [scanId], references: [id], onDelete: Cascade)
  packageName    String
  version        String
  packageManager PackageManager
  scope          DependencyScope @default(UNKNOWN)
  manifestPath   String
  purl           String?
  license        String?
  supplier       String?
  metadata       Json            @default("{}")
  createdAt      DateTime        @default(now())
  advisories     Advisory[]

  @@unique([scanId, packageName, version, manifestPath])
  @@index([scanId])
  @@index([packageManager])
}

model AuditEvent {
  id             String        @id @default(cuid())
  actor          String
  action         AuditAction
  entityType     String
  entityId       String
  scanId         String?
  scan           Scan?         @relation(fields: [scanId], references: [id], onDelete: SetNull)
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  correlationId  String?

  @@index([actor])
  @@index([action])
  @@index([entityType, entityId])
  @@index([scanId])
  @@index([organizationId, createdAt])
  @@index([correlationId])
}

model Organization {
  id                  String                  @id @default(cuid())
  slug                String                  @unique
  name                String
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  memberships         Membership[]
  repositories        Repository[]
  sessions            AgentSession[]
  policyBundles       PolicyBundle[]
  simulations         PolicySimulation[]
  integrations        Integration[]
  baselines           AgentBaseline[]
  scans               Scan[]
  auditEvents         AuditEvent[]
  githubInstallations GitHubInstallation[]
  webhookDeliveries   GitHubWebhookDelivery[]
  advisories          Advisory[]
  evidenceArtifacts   EvidenceArtifact[]
  agentApprovals      AgentApproval[]
}

model User {
  id          String       @id @default(cuid())
  externalId  String       @unique
  displayName String
  email       String?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
}

model Membership {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId, role])
}

model Repository {
  id                   String              @id @default(cuid())
  organizationId       String
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider             String
  externalId           String
  fullName             String
  defaultBranch        String              @default("main")
  githubInstallationId String?
  githubInstallation   GitHubInstallation? @relation(fields: [githubInstallationId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  sessions             AgentSession[]
  scans                Scan[]
  baselines            AgentBaseline[]

  @@unique([organizationId, provider, externalId])
  @@index([organizationId, fullName])
}

model AgentSession {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repositoryId   String
  repository     Repository         @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  actor          String
  source         String
  taskSummary    String
  status         AgentSessionStatus @default(ACTIVE)
  correlationId  String
  startedAt      DateTime           @default(now())
  completedAt    DateTime?
  events         AgentEvent[]
  agentApprovals AgentApproval[]
  riskNodes      RiskNode[]
  riskEdges      RiskEdge[]
  simulations    PolicySimulation[]
  scans          Scan[]

  @@unique([organizationId, correlationId])
  @@index([organizationId, startedAt])
  @@index([repositoryId, startedAt])
  @@index([status])
}

model AgentApproval {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessionId      String
  session        AgentSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  actor          String
  actionType     String
  resource       String?
  actionDigest   String
  status         ApprovalStatus @default(PENDING)
  requestedBy    String
  reviewedBy     String?
  reason         String?
  correlationId  String
  idempotencyKey String
  requestedAt    DateTime       @default(now())
  reviewedAt     DateTime?

  @@unique([organizationId, sessionId, idempotencyKey])
  @@index([organizationId, status, requestedAt])
  @@index([sessionId, status])
  @@index([organizationId, actionDigest])
  @@index([correlationId])
}

model AgentEvent {
  id             String         @id @default(cuid())
  sessionId      String
  session        AgentSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sequence       Int
  idempotencyKey String
  timestamp      DateTime
  actor          String
  source         String
  type           AgentEventType
  riskLevel      Severity
  summary        String
  resource       String?
  evidence       Json           @default("{}")
  correlationId  String
  previousHash   String?
  eventHash      String
  createdAt      DateTime       @default(now())

  @@unique([sessionId, sequence])
  @@unique([sessionId, idempotencyKey])
  @@index([sessionId, timestamp])
  @@index([correlationId])
  @@index([type, riskLevel])
}

model ScanJob {
  id                  String     @id @default(cuid())
  scanId              String     @unique
  scan                Scan       @relation(fields: [scanId], references: [id], onDelete: Cascade)
  idempotencyKey      String     @unique
  status              ScanStatus @default(QUEUED)
  progress            Int        @default(0)
  attempts            Int        @default(0)
  maxAttempts         Int        @default(3)
  nextAttemptAt       DateTime?
  lockedAt            DateTime?
  lockedBy            String?
  leaseExpiresAt      DateTime?
  lastHeartbeatAt     DateTime?
  cancelRequestedAt   DateTime?
  failureCode         String?
  failureMessage      String?
  deadLetteredAt      DateTime?
  provider            String     @default("LOCAL")
  repositoryRef       String
  commitSha           String?
  policyBundleVersion String
  trigger             String     @default("MANUAL")
  requester           String
  correlationId       String
  payload             Json       @default("{}")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([status, nextAttemptAt])
  @@index([lockedAt])
  @@index([provider, repositoryRef])
  @@index([correlationId])
  @@index([deadLetteredAt])
}

model PolicyBundle {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  environment    PolicyEnvironment
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  versions       PolicyBundleVersion[]

  @@unique([organizationId, name, environment])
  @@index([organizationId, environment])
}

model PolicyBundleVersion {
  id              String             @id @default(cuid())
  bundleId        String
  bundle          PolicyBundle       @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  semanticVersion String
  status          PolicyBundleStatus @default(DRAFT)
  rules           Json
  snapshotHash    String
  createdBy       String
  createdAt       DateTime           @default(now())
  promotedBy      String?
  promotedAt      DateTime?
  simulations     PolicySimulation[]

  @@unique([bundleId, semanticVersion])
  @@index([bundleId, status])
}

model PolicySimulation {
  id              String               @id @default(cuid())
  organizationId  String
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceScanId    String?
  sourceScan      Scan?                @relation(fields: [sourceScanId], references: [id], onDelete: Restrict)
  sourceSessionId String?
  sourceSession   AgentSession?        @relation(fields: [sourceSessionId], references: [id], onDelete: Restrict)
  bundleVersionId String
  bundleVersion   PolicyBundleVersion  @relation(fields: [bundleVersionId], references: [id], onDelete: Restrict)
  status          SimulationStatus     @default(QUEUED)
  createdBy       String
  createdAt       DateTime             @default(now())
  completedAt     DateTime?
  summary         Json                 @default("{}")
  decisions       SimulationDecision[]

  @@index([organizationId, createdAt])
  @@index([sourceScanId])
  @@index([sourceSessionId])
}

model SimulationDecision {
  id                String             @id @default(cuid())
  simulationId      String
  simulation        PolicySimulation   @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  findingId         String
  originalDecision  PolicyDecisionType
  simulatedDecision PolicyDecisionType
  originalRuleId    String
  simulatedRuleId   String
  conditionTrace    Json

  @@unique([simulationId, findingId])
  @@index([simulationId, simulatedDecision])
}

model RiskNode {
  id        String       @id @default(cuid())
  sessionId String
  session   AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind      RiskNodeKind
  label     String
  riskLevel Severity
  eventId   String?
  resource  String?
  metadata  Json         @default("{}")
  outgoing  RiskEdge[]   @relation("RiskEdgeFrom")
  incoming  RiskEdge[]   @relation("RiskEdgeTo")

  @@index([sessionId, riskLevel])
}

model RiskEdge {
  id          String         @id @default(cuid())
  sessionId   String
  session     AgentSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fromNodeId  String
  fromNode    RiskNode       @relation("RiskEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId    String
  toNode      RiskNode       @relation("RiskEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  relation    String
  explanation String
  confidence  EdgeConfidence

  @@unique([sessionId, fromNodeId, toNodeId, relation])
  @@index([sessionId])
}

model EvidenceArtifact {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  findingId      String?
  sessionId      String?
  mediaType      String
  digest         String
  storageKey     String
  redacted       Boolean       @default(true)
  sizeBytes      Int
  createdAt      DateTime      @default(now())

  @@unique([digest, storageKey])
  @@index([organizationId, createdAt])
  @@index([findingId])
  @@index([sessionId])
}

model SecurityReceipt {
  id                  String             @id @default(cuid())
  scanId              String             @unique
  scan                Scan               @relation(fields: [scanId], references: [id], onDelete: Restrict)
  schemaVersion       String             @default("1")
  scannerVersion      String
  policyBundleVersion String
  branch              String?
  commitSha           String?
  findingCounts       Json
  decisionCounts      Json
  approvalState       String
  evidenceDigest      String
  gateResult          PolicyDecisionType
  signingAlgorithm    String?
  keyId               String?
  signature           String?
  signedPayload       Json?
  receiptHash         String             @unique
  createdAt           DateTime           @default(now())
}

model GitHubInstallation {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installationId Int                     @unique
  accountLogin   String
  accountType    String?
  status         String                  @default("ACTIVE")
  permissions    Json                    @default("{}")
  installedAt    DateTime                @default(now())
  lastSyncedAt   DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  repositories   Repository[]
  deliveries     GitHubWebhookDelivery[]

  @@unique([organizationId, accountLogin])
  @@index([organizationId, status])
}

model GitHubWebhookDelivery {
  id                 String             @id @default(cuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installationId     Int
  installation       GitHubInstallation @relation(fields: [installationId], references: [installationId], onDelete: Restrict)
  deliveryId         String
  eventName          String
  action             String?
  repositoryFullName String?
  status             String             @default("RECEIVED")
  receivedAt         DateTime           @default(now())
  processedAt        DateTime?
  failureReason      String?
  attempts           Int                @default(0)
  nextAttemptAt      DateTime?
  correlationId      String
  payloadHash        String
  scanId             String?
  scan               Scan?              @relation(fields: [scanId], references: [id], onDelete: SetNull)

  @@unique([organizationId, deliveryId])
  @@index([organizationId, status, receivedAt])
  @@index([installationId, receivedAt])
  @@index([correlationId])
  @@index([organizationId, scanId])
}

model Advisory {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scanId          String?
  scan            Scan?        @relation(fields: [scanId], references: [id], onDelete: SetNull)
  dependencyId    String?
  dependency      Dependency?  @relation(fields: [dependencyId], references: [id], onDelete: SetNull)
  packageName     String
  version         String
  ecosystem       String
  advisoryId      String
  aliases         Json         @default("[]")
  affectedRange   String?
  severity        String?
  cvss            Float?
  fixedVersion    String?
  firstSeen       DateTime     @default(now())
  lastSeen        DateTime     @default(now())
  resolutionState String       @default("OPEN")

  @@unique([organizationId, advisoryId, packageName, version])
  @@index([organizationId, packageName, version])
  @@index([scanId])
  @@index([dependencyId])
}

model Integration {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String
  status         String
  configuration  Json         @default("{}")
  lastHealthAt   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, provider])
}

model AgentBaseline {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repositoryId    String?
  repository      Repository?  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  agentIdentifier String
  sampleSize      Int
  metrics         Json
  calculatedAt    DateTime     @default(now())

  @@unique([organizationId, repositoryId, agentIdentifier])
  @@index([organizationId, agentIdentifier])
}
