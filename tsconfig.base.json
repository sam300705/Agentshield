{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "baseUrl": ".",
    "paths": {
      "@agentshield/schemas": ["packages/schemas/src/index.ts"],
      "@agentshield/scanner": ["packages/scanner/src/index.ts"],
      "@agentshield/policy-engine": ["packages/policy-engine/src/index.ts"],
      "@agentshield/remediation": ["packages/remediation/src/index.ts"]
    }
  }
}
