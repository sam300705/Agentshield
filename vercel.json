{
  "framework": "vite",
  "installCommand": "PATH=\"$PWD/.bin:$PATH\" PRISMA_SKIP_POSTINSTALL_GENERATE=true pnpm install --frozen-lockfile",
  "buildCommand": "PATH=\"$PWD/.bin:$PATH\" pnpm --filter @agentshield/web-dashboard... build",
  "outputDirectory": "apps/web-dashboard/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
