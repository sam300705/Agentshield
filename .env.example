NODE_ENV=development

# Render injects PORT for the API web service; API_PORT remains the local fallback.
PORT=3001
API_PORT=3001
WEB_PORT=5173
CORS_ORIGIN=http://localhost:5173

# Frontend mode: any value other than live renders the labeled deterministic demo.
VITE_APP_MODE=demo
VITE_API_BASE_URL=http://localhost:3001
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback
VITE_OIDC_AUTHORIZATION_ENDPOINT=
VITE_OIDC_TOKEN_ENDPOINT=
VITE_OIDC_JWKS_URI=
VITE_OIDC_END_SESSION_ENDPOINT=
VITE_OIDC_AUDIENCE=
VITE_OIDC_SCOPES="openid profile email"

# Authentication is fail-closed by default. Demo mode is for non-production local use only.
# Local demo: keep DEMO_AUTH_ENABLED=true and leave OIDC values blank.
# Production: set DEMO_AUTH_ENABLED=false, keep AUTH_MODE=oidc, and provide all OIDC values.
DEMO_AUTH_ENABLED=true
AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLE_CLAIM=roles

# The limiter is disabled by default outside production and enabled by default in production.
# This limiter is per API instance; use an edge/distributed limiter for multi-replica deployments.
RATE_LIMIT_ENABLED=
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Optional integrations. Keep live lifecycle wiring disabled until persistence and policy are reviewed.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_ENABLED=false
# Phase 1 rejects enabling lifecycle/materialization until Phase 3 qualification.
GITHUB_SCAN_LIFECYCLE_ENABLED=false
GITHUB_MATERIALIZATION_ENABLED=false
GITHUB_SCAN_POLICY_BUNDLE_VERSION=
# The standalone scanner uses --osv for opt-in enrichment; the API worker does not enable it automatically.
OSV_API_ENABLED=false
OSV_API_BASE_URL=https://api.osv.dev
OSV_REQUEST_TIMEOUT_MS=5000
OSV_MAX_RETRIES=2
RECEIPT_SIGNING_KEY_ID=
RECEIPT_SIGNING_PRIVATE_KEY=
RECEIPT_SIGNING_PUBLIC_KEYS_JSON=

# Disposable local development defaults; these are not production credentials.
# Keep these fields and both URLs in sync when customizing Compose.
# For Neon, DATABASE_URL should be the pooled URL for runtime traffic and
# DATABASE_URL_UNPOOLED should be the direct URL for Prisma migrations.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agentshield
POSTGRES_PASSWORD=agentshield_dev_password
POSTGRES_DB=agentshield
DATABASE_URL=postgresql://agentshield:agentshield_dev_password@localhost:5432/agentshield?schema=public
DATABASE_URL_UNPOOLED=postgresql://agentshield:agentshield_dev_password@localhost:5432/agentshield?schema=public

# Trust only actual reverse-proxy IPs/CIDRs; empty means direct connections only.
TRUSTED_PROXY_CIDRS=
