NODE_ENV=development

API_PORT=3001
WEB_PORT=5173
CORS_ORIGIN=http://localhost:5173

# Authentication is fail-closed by default. Demo mode is for non-production local use only.
DEMO_AUTH_ENABLED=true
AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLE_CLAIM=roles

# Use a local or managed PostgreSQL URL. Never commit real credentials.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agentshield
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentshield
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
