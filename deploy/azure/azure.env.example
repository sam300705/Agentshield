NODE_ENV=production
DOMAIN=api.example.com
CORS_ORIGIN=https://dashboard.example.com

# Neon pooled URL for API and worker runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-POOLER.REGION.aws.neon.tech/DATABASE?schema=public&sslmode=require&connect_timeout=5&connection_limit=3&pool_timeout=5
# Neon direct URL for Prisma migrations only.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?schema=public&sslmode=require&connect_timeout=5&connection_limit=3&pool_timeout=5

AUTH_MODE=oidc
DEMO_AUTH_ENABLED=false
OIDC_ISSUER=https://issuer.example.com/
OIDC_AUDIENCE=agentshield-api
OIDC_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
OIDC_ROLE_CLAIM=roles

# Required shared request protection (platform secrets in hosted deployments).
REDIS_REST_URL=
REDIS_REST_TOKEN=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY_HOPS=1

# Required worker receipt custody; generate outside Git/chat and retain verification public keys.
RECEIPT_SIGNING_REQUIRED=true
RECEIPT_SIGNING_KEY_ID=
RECEIPT_SIGNING_PRIVATE_KEY=

# Optional live GitHub integration. See docs/github-app.md for registration and flag coherence.
GITHUB_WEBHOOK_ENABLED=false
GITHUB_SCAN_LIFECYCLE_ENABLED=false
GITHUB_MATERIALIZATION_ENABLED=false
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_SCAN_POLICY_BUNDLE_VERSION=

# Optional platform telemetry; these are backend secrets, not frontend variables.
METRICS_TOKEN=
ERROR_REPORT_URL=
ERROR_REPORT_TOKEN=
