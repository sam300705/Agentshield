NODE_ENV=production
DOMAIN=api.example.com
CORS_ORIGIN=https://agentshield-git-agent-production-hardening-sam300705s-projects.vercel.app

# Neon pooled URL for API and worker runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-POOLER.REGION.aws.neon.tech/DATABASE?schema=public&sslmode=require&connect_timeout=15
# Neon direct URL for Prisma migrations only.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?schema=public&sslmode=require&connect_timeout=15

AUTH_MODE=oidc
DEMO_AUTH_ENABLED=false
OIDC_ISSUER=https://issuer.example.com/
OIDC_AUDIENCE=agentshield-api
OIDC_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
OIDC_ROLE_CLAIM=roles

# Optional server-side AI gateway. Keep this value only on the VM.
OPENROUTER_API_KEY=
